{
  "name": "cypress-automation-training",
  "version": "1.0.0",
  "description": "A Cypress automation training framework — from basics through Page Object Model, API testing, and CI/CD",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:module1": "cypress run --spec 'cypress/e2e/module1-basics/**'",
    "cy:run:module2": "cypress run --spec 'cypress/e2e/module2-ui-interactions/**'",
    "cy:run:module3": "cypress run --spec 'cypress/e2e/module3-advanced/**'",
    "cy:run:module4": "cypress run --spec 'cypress/e2e/module4-pom/**'",
    "cy:run:module5": "cypress run --spec 'cypress/e2e/module5-ai-qa/**'"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "cypress": "^13.13.0"
  }
}
